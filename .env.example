# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is committed as a template.

# --- Required ---
BOT_TOKEN=bot-token
# Os 3 slots abaixo são só o valor INICIAL: quem manda em runtime é `.bot.runtime`
# (escrito por `./bot.sh --model`). Troca de modelo com o bot no ar, sem mexer aqui.
# Modelo das passadas curtas e classificatórias: portão de intenção (kb vs chat),
# condensador de pergunta e juiz de fidelidade. Cada uma só devolve uma palavra ou linha,
# então vale um modelo pequeno e quente — ele roda em quase toda mensagem.
# (O nome "brain" é herdado da passada antiga de ferramentas; a chave foi mantida.)
BRAIN_MODEL_NAME=qwen2.5:14b-instruct-q4_K_M
# Modelo da voz — TODA resposta visível (papo em persona, o retelling dos dados de HSR
# e o resumo do /contexto-do-canal). É esse que você troca pra melhorar a prosa. Qualquer modelo de chat serve.
VOICE_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
# Modelo de VISÃO (opcional): extrai o conteúdo de prints/imagens anexadas (build,
# relíquia, resultado de batalha) como texto antes do pipeline normal. Precisa de um
# modelo vision-capable: `ollama pull qwen2.5vl` (ou llava, llama3.2-vision).
# VAZIO = visão desligada, imagens são ignoradas e o bot responde só ao texto.
VISION_MODEL_NAME=

# --- Database ---
DB_USER=hsrbot
DB_PASSWORD=hsrbot

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Janela de contexto (tokens). Precisa caber: persona (~3.9k) + histórico da cadeia de
# reply + num_predict (512). O default 4096 truncava o histórico, sobrando só a persona —
# por isso os replies perdiam o contexto. 16384 deixa espaço de sobra pra threads longas.
OLLAMA_NUM_CTX=16384
# Orçamento de tokens do retelling em persona da resposta de conhecimento. O num_predict
# normal (512) serve pra uma resposta curta de papo, mas esmaga um kit completo.
# Aumente se kits muito longos ainda saírem cortados.
OLLAMA_KNOWLEDGE_NUM_PREDICT=2048

# --- Optional bot tuning ---
# Uncomment and set to override the bundled persona (e.g. file:/etc/hsr-bot/persona.md).
# A persona embutida é DE PROPÓSITO neutra e sem nome — é aqui que você troca a voz do bot
# pela sua, sem recompilar. Nada no código depende do texto dela.
# Default when UNSET: classpath:prompts/persona.md (bundled in the JAR).
# IMPORTANT: leave this LINE COMMENTED OUT if you want the default. Setting it to an
# empty string is treated as "blank" and triggers a fallback warning at startup.
#BOT_PERSONALITY_FILE=
# Lista de canais (IDs separados por vírgula) onde o bot funciona — menções, conversas E
# comandos de barra. Vazio = funciona em todos os canais. DMs nunca são restringidas.
# Ex.: TEST_CHANNEL_IDS=123456789012345678,987654321098765432
TEST_CHANNEL_IDS=

# Marca da casa nos cards (/guia, /ascensao, /build, /tierlist). VAZIAS = card sem marca
# nenhuma, que é o padrão. BOT_LOGO é um caminho de ARQUIVO (PNG transparente fica melhor),
# não um recurso do JAR, então dá pra trocar sem recompilar. O /rank ignora as duas: ele
# desenha o ícone e o nome do próprio servidor.
BOT_LOGO=
BOT_TAG=

# --- Quem o bot atende (importante com ele num host 24/7) ---
# Lista de SERVIDORES (IDs separados por vírgula) onde o bot funciona. Vazio = todos.
# Diferente de TEST_CHANNEL_IDS, que escolhe canais DENTRO de um servidor e só vale pros
# comandos de IA: os comandos de barra são registrados globalmente, então sem esta lista
# qualquer link de convite aponta os renders, o Enka e o Ollama pra esta máquina.
# Convite pra servidor fora da lista: o bot sai sozinho na hora. Servidor onde ele JÁ estava
# quando a lista foi criada: só um WARN no log, e os comandos passam a ser recusados lá —
# tirar de vez é no painel do Discord, de propósito (um id digitado errado não expulsa nada).
GUILD_IDS=
# Se o bot responde no privado. A DM não tem servidor pra escopar e ninguém além de quem
# mandou enxerga — é o único caminho onde dá pra gastar a IA da casa sem ninguém ver.
DM_ENABLED=true
# Pausa entre duas menções da MESMA pessoa na DM (no canal são 5s, fixos). Maior porque num
# canal quem martela o bot está à vista de um moderador; na DM, só este número está.
DM_COOLDOWN_SECONDS=30

# Papel deste host. "bot" (padrão) sobe tudo; "ollama" recusa subir o bot e deixa a máquina
# só servindo modelos — é o que a máquina de IA deve ter depois que o bot foi pro servidor. Duas
# instâncias no MESMO token não dão erro: as duas respondem, e o usuário vê resposta dobrada.
#BOT_ROLE=ollama

# Destino do `./bot.sh deploy` (só no Mac; o servidor não precisa destas duas). O código
# viaja pelo git, então o servidor tem que ser um clone do MESMO repo e o push tem que ir
# pra um remote que ele alcança. DEPLOY_DIR é relativo ao home (ou absoluto), sem `~`.
#DEPLOY_HOST=usuario@servidor
#DEPLOY_DIR=HsrBot

# Nível de log de com.hsrbot. DEBUG imprime o CONTEÚDO das mensagens dos usuários — ótimo pra
# caçar bug na sua máquina, ruim num host 24/7 (conversa alheia gravada, e disco cheio no
# mesmo disco do Postgres e dos backups). Padrão INFO.
#LOG_LEVEL=DEBUG

# Busca web (fallback searchWeb) — SearXNG via docker/searxng
SEARXNG_URL=http://localhost:8888
# Quantos dos primeiros resultados a busca abre e LÊ por inteiro (texto da página), em
# vez de só o snippet do SearXNG — é o que torna kits vazados/futuros respondíveis de
# fato. 0 = só snippets. Baixo de propósito (2): melhor ler poucas páginas a fundo do
# que muitas raso (wikis enterram o kit ~14k chars dentro). Snippets ainda vêm de todos.
HSR_WEB_FETCH_PAGES=2
# Limite de caracteres por página injetada no prompt (limita o uso do contexto). Grande
# de propósito: em páginas tipo game8 os multiplicadores só aparecem ~14–16k chars adentro,
# depois do índice/ratings. Reduza se rodar com num_ctx menor.
HSR_WEB_FETCH_CHARS=18000

# --- Base de conhecimento HSR (reindex) ---
# true = na PRÓXIMA inicialização o bot APAGA o vector_store e re-embeda tudo do nanoka,
# gravando a versão indexada em kb_meta. Rode UMA vez e volte pra false. O KbFreshnessCheck
# loga um WARN diário quando sai patch novo (ou enquanto nenhuma versão foi indexada) —
# esse warning é o lembrete de rodar isto.
#   HSR_REINDEX=true java -jar hsr-bot.jar   (ou mvn spring-boot:run)
HSR_REINDEX=false
# Pinar uma versão específica do nanoka (ex.: 3.4). VAZIO = auto-descoberta da home page.
HSR_NANOKA_VERSION=
