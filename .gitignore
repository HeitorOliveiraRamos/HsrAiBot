# Marca do heartbeat: registra que foi ELE quem desligou a IA, pra não religar por cima
# de um /ia desligar feito por uma pessoa. É estado da máquina, não do projeto.
.bot.ia-caiu

# Dumps do ./bot.sh backup — ~30 MB cada e contêm dados de membros (guia_arte).
# Nunca versionar: o *.tar.gz acima não pega .sql.gz.
backups/
